<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="HeatMapTracker.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:HeatMapTracker.Views"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource Primary}"
       Shell.TitleColor="White"
       Shell.ForegroundColor="White">

    <!-- The view is resolved through dependency injection, so its view model is injected. -->
    <ShellContent Title="MainView"
                  Route="MainView"
                  ContentTemplate="{DataTemplate views:MainView}" />
</Shell>
