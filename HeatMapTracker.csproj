<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- If you only have the .NET 8 or 9 SDK installed, change "net10.0" to "net8.0" / "net9.0" below. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>HeatMapTracker</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>HeatMap Tracker</ApplicationTitle>
    <ApplicationId>com.companyname.heatmaptracker</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    Google Maps API key. The real key lives in ApiKeys.props, which is git-ignored so it never
    ends up in source control. See README.md, "Before you run".
  -->
  <Import Project="ApiKeys.props" Condition="Exists('ApiKeys.props')" />
  <PropertyGroup>
    <GoogleMapsApiKey Condition="'$(GoogleMapsApiKey)' == ''">YOUR_GOOGLE_MAPS_API_KEY</GoogleMapsApiKey>
    <!-- Replaces ${googleMapsApiKey} in Platforms/Android/AndroidManifest.xml at build time. -->
    <AndroidManifestPlaceholders>googleMapsApiKey=$(GoogleMapsApiKey)</AndroidManifestPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon (generated into platform-specific assets at build time). -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
  </ItemGroup>

</Project>
